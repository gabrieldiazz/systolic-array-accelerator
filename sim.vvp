#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x61d3a7d61740 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x61d3a7d618d0 .scope module, "register_tb" "register_tb" 3 1;
 .timescale 0 0;
v0x61d3a7d75fc0_0 .var "clk", 0 0;
v0x61d3a7d76080_0 .var "d", 7 0;
v0x61d3a7d76150_0 .net "q", 7 0, v0x61d3a7d75d90_0;  1 drivers
v0x61d3a7d76250_0 .var "reset", 0 0;
S_0x61d3a7d27490 .scope module, "dut" "register" 3 10, 4 1 0, S_0x61d3a7d618d0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset";
    .port_info 2 /INPUT 8 "d";
    .port_info 3 /OUTPUT 8 "q";
P_0x61d3a7d27670 .param/l "WIDTH" 0 4 2, +C4<00000000000000000000000000001000>;
v0x61d3a7d4e950_0 .net "clk", 0 0, v0x61d3a7d75fc0_0;  1 drivers
v0x61d3a7d4f7f0_0 .net "d", 7 0, v0x61d3a7d76080_0;  1 drivers
v0x61d3a7d75d90_0 .var "q", 7 0;
v0x61d3a7d75e50_0 .net "reset", 0 0, v0x61d3a7d76250_0;  1 drivers
E_0x61d3a7d3b590 .event posedge, v0x61d3a7d4e950_0;
    .scope S_0x61d3a7d27490;
T_0 ;
    %wait E_0x61d3a7d3b590;
    %load/vec4 v0x61d3a7d75e50_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 8;
    %assign/vec4 v0x61d3a7d75d90_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x61d3a7d4f7f0_0;
    %assign/vec4 v0x61d3a7d75d90_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x61d3a7d618d0;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x61d3a7d75fc0_0, 0, 1;
T_1.0 ;
    %delay 5, 0;
    %load/vec4 v0x61d3a7d75fc0_0;
    %inv;
    %store/vec4 v0x61d3a7d75fc0_0, 0, 1;
    %jmp T_1.0;
    %end;
    .thread T_1;
    .scope S_0x61d3a7d618d0;
T_2 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x61d3a7d76250_0, 0, 1;
    %pushi/vec4 42, 0, 8;
    %store/vec4 v0x61d3a7d76080_0, 0, 8;
    %wait E_0x61d3a7d3b590;
    %delay 1, 0;
    %load/vec4 v0x61d3a7d76150_0;
    %pad/u 32;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_2.0, 4;
    %jmp T_2.1;
T_2.0 ;
    %vpi_call/w 3 30 "$error", "output doesnt reset when reset=1" {0 0 0};
T_2.1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x61d3a7d76250_0, 0, 1;
    %pushi/vec4 42, 0, 8;
    %store/vec4 v0x61d3a7d76080_0, 0, 8;
    %wait E_0x61d3a7d3b590;
    %delay 1, 0;
    %load/vec4 v0x61d3a7d76150_0;
    %load/vec4 v0x61d3a7d76080_0;
    %cmp/e;
    %jmp/0xz  T_2.2, 4;
    %jmp T_2.3;
T_2.2 ;
    %vpi_call/w 3 39 "$error", "output doesnt match d at rising edge" {0 0 0};
T_2.3 ;
    %vpi_call/w 3 41 "$display", "all tests passed!" {0 0 0};
    %vpi_call/w 3 42 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb/register_tb.sv";
    "rtl/register.sv";
