:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x63bb626838b0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x63bb62683a40 .scope module, "and_gate_tb" "and_gate_tb" 3 1;
 .timescale 0 0;
v0x63bb62698ed0_0 .var "a", 0 0;
v0x63bb62698fa0_0 .var "b", 0 0;
v0x63bb62699070_0 .net "y", 0 0, L_0x63bb62699170;  1 drivers
S_0x63bb6264a490 .scope module, "dut" "and_gate" 3 7, 4 1 0, S_0x63bb62683a40;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
L_0x63bb62699170 .functor AND 1, v0x63bb62698ed0_0, v0x63bb62698fa0_0, C4<1>, C4<1>;
v0x63bb6264a6c0_0 .net "a", 0 0, v0x63bb62698ed0_0;  1 drivers
v0x63bb62698cf0_0 .net "b", 0 0, v0x63bb62698fa0_0;  1 drivers
v0x63bb62698db0_0 .net "y", 0 0, L_0x63bb62699170;  alias, 1 drivers
    .scope S_0x63bb62683a40;
T_0 ;
    %vpi_call/w 3 14 "$monitor", "time=%0t a=%b b=%b y=%b", $time, v0x63bb62698ed0_0, v0x63bb62698fa0_0, v0x63bb62699070_0 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x63bb62683a40;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x63bb62698ed0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x63bb62698fa0_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x63bb62699070_0;
    %pad/u 32;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_1.0, 4;
    %jmp T_1.1;
T_1.0 ;
    %vpi_call/w 3 22 "$error", "0 AND 0 failed" {0 0 0};
T_1.1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x63bb62698ed0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x63bb62698fa0_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x63bb62699070_0;
    %pad/u 32;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_1.2, 4;
    %jmp T_1.3;
T_1.2 ;
    %vpi_call/w 3 28 "$error", "0 AND 0 failed" {0 0 0};
T_1.3 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x63bb62698ed0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x63bb62698fa0_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x63bb62699070_0;
    %pad/u 32;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_1.4, 4;
    %jmp T_1.5;
T_1.4 ;
    %vpi_call/w 3 34 "$error", "0 AND 0 failed" {0 0 0};
T_1.5 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x63bb62698ed0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x63bb62698fa0_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x63bb62699070_0;
    %pad/u 32;
    %cmpi/e 1, 0, 32;
    %jmp/0xz  T_1.6, 4;
    %jmp T_1.7;
T_1.6 ;
    %vpi_call/w 3 41 "$error", "0 AND 0 failed" {0 0 0};
T_1.7 ;
