#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x555f221a1d90 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x555f221a1f20 .scope module, "mac_tb" "mac_tb" 3 1;
 .timescale 0 0;
v0x555f221b9e10_0 .var "a", 7 0;
v0x555f221b9ef0_0 .net "acc", 31 0, v0x555f2218f9c0_0;  1 drivers
v0x555f221b9f90_0 .var "b", 7 0;
v0x555f221ba060_0 .var "clk", 0 0;
v0x555f221ba130_0 .var "reset", 0 0;
S_0x555f22167490 .scope module, "dut" "mac" 3 10, 4 1 0, S_0x555f221a1f20;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset";
    .port_info 2 /INPUT 8 "a";
    .port_info 3 /INPUT 8 "b";
    .port_info 4 /OUTPUT 32 "acc";
P_0x555f22167670 .param/l "WIDTH" 0 4 2, +C4<00000000000000000000000000001000>;
v0x555f2218ef50_0 .net "a", 7 0, v0x555f221b9e10_0;  1 drivers
v0x555f2218f9c0_0 .var "acc", 31 0;
v0x555f2218fe20_0 .net "b", 7 0, v0x555f221b9f90_0;  1 drivers
v0x555f221907a0_0 .net "clk", 0 0, v0x555f221ba060_0;  1 drivers
v0x555f221913d0_0 .net "reset", 0 0, v0x555f221ba130_0;  1 drivers
E_0x555f221a08d0 .event posedge, v0x555f221907a0_0;
    .scope S_0x555f22167490;
T_0 ;
    %wait E_0x555f221a08d0;
    %load/vec4 v0x555f221913d0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 32;
    %assign/vec4 v0x555f2218f9c0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x555f2218f9c0_0;
    %load/vec4 v0x555f2218ef50_0;
    %pad/u 32;
    %load/vec4 v0x555f2218fe20_0;
    %pad/u 32;
    %mul;
    %add;
    %assign/vec4 v0x555f2218f9c0_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x555f221a1f20;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x555f221ba060_0, 0, 1;
T_1.0 ;
    %delay 5, 0;
    %load/vec4 v0x555f221ba060_0;
    %inv;
    %store/vec4 v0x555f221ba060_0, 0, 1;
    %jmp T_1.0;
    %end;
    .thread T_1;
    .scope S_0x555f221a1f20;
T_2 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x555f221ba130_0, 0, 1;
    %pushi/vec4 2, 0, 8;
    %store/vec4 v0x555f221b9e10_0, 0, 8;
    %pushi/vec4 3, 0, 8;
    %store/vec4 v0x555f221b9f90_0, 0, 8;
    %wait E_0x555f221a08d0;
    %delay 1, 0;
    %load/vec4 v0x555f221b9ef0_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_2.0, 4;
    %jmp T_2.1;
T_2.0 ;
    %vpi_call/w 3 32 "$error", "initial reset failed" {0 0 0};
T_2.1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x555f221ba130_0, 0, 1;
    %wait E_0x555f221a08d0;
    %delay 1, 0;
    %load/vec4 v0x555f221b9ef0_0;
    %cmpi/e 6, 0, 32;
    %jmp/0xz  T_2.2, 4;
    %jmp T_2.3;
T_2.2 ;
    %vpi_call/w 3 40 "$error", "multiplication does not work as intended" {0 0 0};
T_2.3 ;
    %wait E_0x555f221a08d0;
    %delay 1, 0;
    %load/vec4 v0x555f221b9ef0_0;
    %cmpi/e 12, 0, 32;
    %jmp/0xz  T_2.4, 4;
    %jmp T_2.5;
T_2.4 ;
    %vpi_call/w 3 48 "$error", "accumulation does not add over another positive edge" {0 0 0};
T_2.5 ;
    %wait E_0x555f221a08d0;
    %delay 1, 0;
    %load/vec4 v0x555f221b9ef0_0;
    %cmpi/e 18, 0, 32;
    %jmp/0xz  T_2.6, 4;
    %jmp T_2.7;
T_2.6 ;
    %vpi_call/w 3 54 "$error", "accumulation does not add over another positive edge" {0 0 0};
T_2.7 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x555f221ba130_0, 0, 1;
    %wait E_0x555f221a08d0;
    %delay 1, 0;
    %load/vec4 v0x555f221b9ef0_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_2.8, 4;
    %jmp T_2.9;
T_2.8 ;
    %vpi_call/w 3 61 "$error", "reset does not reset mac's output" {0 0 0};
T_2.9 ;
    %vpi_call/w 3 63 "$display", "all tests passed!" {0 0 0};
    %vpi_call/w 3 64 "$finish" {0 0 0};
    %end;
    .thread T_2;
